#include <iostream>
#include <vector>
#include <algorithm>

using namespace std;
int minCoinsForChange(const vector<int>& coins, int amount) {
  
    vector<int> dp(amount + 1, amount + 1);
    dp[0] = 0;
    for (int i = 1; i <= amount; ++i) {
        for (int coin : coins) {
            if (i - coin >= 0) {
     
                dp[i] = min(dp[i], 1 + dp[i - coin]);
            }
        }
    }
    return (dp[amount] > amount) ? -1 : dp[amount];
}

int main() {
    vector<int> coins1 = {1, 2, 5};
    int amount1 = 11;
    cout << "Min coins for amount " << amount1 << ": " << minCoinsForChange(coins1, amount1) << endl; 
    vector<int> coins2 = {1, 3, 4, 5};
    int amount2 = 7;
    cout << "Min coins for amount " << amount2 << ": " << minCoinsForChange(coins2, amount2) << endl; 
    vector<int> coins3 = {2, 4};
    int amount3 = 3;
    cout << "Min coins for amount " << amount3 << ": " << minCoinsForChange(coins3, amount3) << endl; 

    return 0;
}
